<script>
function page(){
	var p = document.getElementById("pageinput").value;
	if(isPositiveNum(p)){window.open("/sort-1-"+p+"/","_self");}
	function isPositiveNum(s){ 
    var re = /^[0-9]*[1-9][0-9]*$/ ;  
	    return re.test(s)  
	}
}
