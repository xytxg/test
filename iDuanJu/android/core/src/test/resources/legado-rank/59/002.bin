<script type="text/javascript">

    var maxPage = "50";
    var value = '1';

    function selectChange() {
        var objS = document.getElementById("chapterFilter");
        var value1 = objS.options[objS.selectedIndex].value;
        
        document.getElementById(value).style.display = "none";
        document.getElementById(value1).style.display = "";
        value = value1;
        ctrl_button(value);
    }

    
    if (value == '1' && maxPage != value) {
        $("#prev_button_id_box").hide();
    }

    function pre_page() {
        var cur = parseInt(value);
        var pre_cur = cur - 1;
        if (pre_cur >= 1) {
            $("#next_button_id_box").show();
            $("#chapterFilter").val(pre_cur);
            ctr_page(pre_cur, cur);
            value = pre_cur;
            if (pre_cur == 1) {
                $("#prev_button_id_box").hide();
                $("#next_button_id_box").show();
            }
        }
    }

    function next_page() {
        var cur = parseInt(value);
        var next_cur = cur + 1;
        if (next_cur <= parseInt(maxPage)) {
            $("#prev_button_id_box").show();
            $("#chapterFilter").val(cur);
            ctr_page(next_cur, cur);
            value = next_cur;
            if (cur == parseInt(maxPage)) {
                $("#next_button_id_box").hide();
            }
        }
    }

    function ctrl_button(curr_page) {
        if (curr_page == 1) {
            $("#prev_button_id_box").hide();
            $("#next_button_id_box").show();
        } else if (curr_page == parseInt(maxPage)) {
            $("#prev_button_id_box").show();
            $("#next_button_id_box").hide();
        } else {
            $("#prev_button_id_box").show();
            $("#next_button_id_box").show();
        }
    }

    function ctr_page(show_id, hide_id) {
        $("#" + show_id).show();
        $("#" + hide_id).hide();
    }

    
    var msg = '<p style="font-size: 18px; line-height: 35px; text-align: center;">下载APP开启免费畅读体验</br> 正版小说承诺终身免费 </br> 光速追更紧跟作者脚步</p>';

    
    function gotoContent(chapter_id) {
        layer.open({
            content: msg
            , btn: ['立即下载', '取消']
            , shadeClose: false
            , yes: function (index) {
                loadDownloadAPP('212201', '豪门战神', 'c3222', "", '');
                setTimeout(function () {
                    layer.close(index);
                }, 500);
            }
            , no: function () {
                gotoPage('/r/212201/' + chapter_id + '.html')
            }
        })

    }

    
    var group_start =  0 ;
    var read_book_id =  212201 ;
    var plat_type = "ios";
    var time_out = 2000;
    var is_zy =  null ;
    var remote_ip =  null ;
    var template_id =  null ;
    var current_chapter = 212201  +1;
    var cps_name = "掌中云";

    function loadDownloadAPP(book_id, book_name, download_source, elem, text_elem) {
        
        _czc.push(["_trackEvent", "app", "阅读下载", book_name, 1, download_source]);

        var group_book_id = group_start + "" + book_id;
        var bookinfo = new Base64().encode("yueyou:" + book_name + "<;>" + group_book_id + "<;>" + current_chapter + "<;>" + download_source);
        var clipboard = new ClipboardJS("body", {
            text: function () {
                return bookinfo;
            }
        });
        
        clipboard.on('success', function (e) {
            console.log("复制成功");
        });
        clipboard.on('error', function (e) {
            console.log('复制失败');
        });

        if (elem) {
            var srcText1 = "";
            $(elem).removeAttr("onclick"); 
            $(elem).off("click");          
            if (elem.tagName.toLowerCase() == text_elem) {
                srcText1 = $(elem).text();
                $(elem).text("加载中...");
            } else {
                srcText1 = $(elem).find(text_elem).text();
                $(elem).find(text_elem).text("加载中...");
            }
        }
        if (plat_type == "ios") {
            if (is_zy) {
                dowloadZYIOS();
            } else {
                dowLoadYYIOS(book_name, group_book_id, download_source, current_chapter, remote_ip, read_book_id, cps_name);
            }
        } else {
            if (is_zy) {
                dowLoadAndroid();
            } else {
                
                window.location.href = "yueyoureader://host:8081/read?bookInfo=" + encodeURIComponent(bookinfo);
                setTimeout(function () {
                    dowLoadYYAndroid(book_name, group_book_id, download_source,
                        current_chapter, remote_ip, read_book_id, cps_name);
                }, 3000)
            }
        }

        

        function backBind(book_id, book_name, download_source, elem, text_elem, srcText) {
            
            if (elem) {
                if (elem.tagName.toLowerCase() == text_elem) {
                    $(elem).text(srcText);
                } else {
                    $(elem).find(text_elem).text(srcText);
                }
                $(elem).on("click", function () {
                    console.log('repeat click');
                    clipboard.destroy();
                    loadDownloadAPP(book_id, book_name, download_source, elem, text_elem, template_id);
                })
            }
        }

        
        setTimeout(function () {
            backBind(book_id, book_name, download_source, elem, text_elem, srcText1)
        }, time_out);

        return false;
    }

    function hide_statics() {
        var sa = $("a[title='站长统计']");
        if (sa.length !== 0) {
            var web_id = sa.attr("href").split("web_id=")[1];
            $("#cnzz_stat_icon_" + web_id).hide();
            sa.hide();
        }
    }

    setTimeout(hide_statics, 300);
</script>
