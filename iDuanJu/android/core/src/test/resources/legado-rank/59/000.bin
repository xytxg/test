<script>
    var tur = true;
    var state_id = parseInt( null );
    var range = 0,
        maxpage = parseInt( 1 ) + 1,
        page = 2,
        totalHeight = 0;

    function loadData() {
        $(window).scroll(function () {
            if (tur) {
                setTimeout(fnscroll, 100);
                tur = false;
            }
        })
    }

    loadData();

    function fnscroll() {
        if (page === -1)
            return;
        if (page === maxpage) {
            $('.v-list').append('<div class="z_loading1">已到底</div>');
            page = -1;
            return;
        }
        var scrollHeight = $(window).scrollTop(); 
        totalHeight = parseFloat($(window).height()) + parseFloat(scrollHeight); 
        if (($(document).height() * 2 / 3) <= totalHeight && page !== maxpage) {
            if ($(document).height() <= totalHeight)
                $('.v-list').append('<div class="z_loading"><em/>正在加载更多数据</div>');
            if (page === -1) {
                return;
            }
            var post_url = "";
            if (state_id === 0) {
                post_url = '/api/state/recommends?template_id=&classify_id=' + '&page=' + page;
            } else {
                post_url = '/api/state/books?state_id=' + '&page=' + page;
            }
            $.ajax({
                async: true,
                cache: false,
                type: 'get',
                url: post_url,
                dataType: "json",
                error: function () {
                },
                success: function (result) {
                    $(".z_loading").remove();
                    $(".z_loading1").remove();
                    if (result.code === 0) {
                        if (result.data.book_info.list.length === 0) {
                            $('.v-list').append('<div class="z_loading1">已到底</div>');
                            page = -1;
                        } else {
                            addData(result);
                            page++;
                        }
                    }
                }
            });

        }
        tur = true;
    }

    function addData(result) {
        for (var i = 0; i < result.data.book_info.list.length; i++) {
            var book = result.data.book_info.list[i];
            var str = '/b/' + book.id + '.html';
            var s = '<div class="v-list-item flex" onclick=\"newWebView(\'' + str + '\', \'\',\'\')\">' +
                '<div class="v-cover"> <img class="v-cover-img" src=' + book.book_pic + '> </div>' +
                '<div class="v-info flex-item flexcol-justify">' +
                '<div class="v-content">' +
                '<div class="v-title">' + book.book_name + '</div>' +
                '<div class="v-intro">' + book.intro + '</div></div>' +
                '<div class="v-other flex-v-end">' +
                '<div class="v-author">' + book.author_name + '&nbsp; &nbsp;</div>' +
                '<div class="v-words flex-item">' + (book.words / 10000).toFixed(1) + '万字</div>' +
                '<div class="v-group flex"><div class="border-1px base-label">' + book.classify_second_name + '</div></div></div></div>';
            $('.v-list').append(s);
        }
    }
</script>
</body>
