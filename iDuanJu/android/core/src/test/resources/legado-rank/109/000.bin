oyuewenhua.net/app/cover/9fcab6c65c90828efa8dc4e96ac124ac.jpg","bigCoverUrl":"http://scdn.taoyuewenhua.net/app/bcover/90db816c6400e91becd1309422823bb8.jpg","categoryName":"都市","createTime":1701765855000,"chapterSize":782,"recommend":"推荐-11-男频","recommendId":"recommend-1794923361:11:1:1000:n","status":50,"completeOn":1727700148000,"score":84,"offline":0,"issue":128,"searchOffline":34,"cpName":"第三方","rank":3,"goReading":true,"tagList":["扮猪吃老虎"],"mainTagList":["扮猪吃老虎"],"hintTagList":["乡村"],"roleList":["魏大勇"],"boostKeywordList":[],"chargeType":0,"chargeChapterIdx":17,"latestChapterUpdateTime":1727700148000,"latestChapter":"第782章 多子多福（完结）","latestChapterId":"siji_191235"},{"sourceName":"tf","sourceId":"yw_26432681809939004","title":"一夜风流，高冷女神倒追我","intro":"赵东本是一名特种兵，退伍之际接到上面任务保护一个女人，谁知竟阴差阳错与女人发生关系，陷入舆论风波，一波未平一波又起，赵东竟查出绝症，绝望之时，赵东偶然发现当年传承，从此在大千世界掀起波澜壮阔的传说...","freeType":1,"categoryId":105000,"authorName":"挠痒痒的闲鱼","allWords":1311505,"coverUrl":"https://bookcover.yuewen.com/qdbimg/349573/c_26432681809939004/180?h=pty6qkd9m7pr","bigCoverUrl":"https://bookcover.yuewen.com/qdbimg/349573/c_26432681809939004/600?h=pty6qkd9m7pr","categoryName":"都市","createTime":1712922450000,"chapterSize":490,"recommend":"推荐-11-男频","recommendId":"recommend-1794923361:11:1:1000:n","status":30,"completeOn":1712922450000,"score":85,"offline":0,"issue":2,"searchOffline":2,"cpName":"第三方","rank":4,"goReading":true,"tagList":["都市","战神","女总裁","异能"],"mainTagList":["女总裁","战神"],"hintTagList":[],"roleList":[],"boostKeywordList":[],"chargeType":0,"chargeChapterIdx":17,"latestChapterUpdateTime":1714340863000,"latestChapter":"第五百七十二章 石头的秘密","latestChapterId":"yw_78992292039423018"},{"sourceName":"tf","sourceId":"siji_80364","title":"饥荒年，怒娶十八个老婆开枝散叶","intro":"“二郎，你要媳妇不要？”\n　　穿越到饥荒年，貌美如花的嫂子，用一个窝窝头帮叶沉换了个媳妇。\n　　【叮！】\n　　【“开枝散叶，多子多福”系统绑定在……】\n　　叶沉还能怎么办？\n　　当然是努力娶老婆，卖力完成任务，不停的娶妻，不停的开枝散叶！\n　　多年后，叶沉一脸为难的询问系统：\n　　“统子，朕的儿子们个个都是人中龙凤，到底要立哪个当太子？”","freeType":1,"categoryId":106000,"authorName":"醉卧美人膝","allWords":1359477,"coverU