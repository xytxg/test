#!name=Surge Monitor Pro｜状态监控
#!version=2.3.1
#!desc=单卡片 Surge 状态监控：内存峰值/最低值与采样趋势、引擎运行时间、活跃请求、DNS 缓存、重载记录。v2.3.1 修复短时间连续采样趋势丢失。
#!category=Panels
#!arguments=api_key,api_port:6171,refresh:60,tap:refresh,warn_mib:45,restart:0
#!arguments-desc=api_key：本机 HTTP API 密钥（内置读取失败时必填）；api_port：HTTP API 端口，默认6171；refresh：内存采样最短间隔秒，默认60；tap：右上角操作，默认refresh仅刷新数据/reload手动重载配置/restart二次确认停止引擎；warn_mib：超过该MiB值图标变橙；restart：旧版兼容参数，1强制开启二次确认停止功能，不建议开启。

[Panel]
XY_Surge_Monitor = title="Surge 状态监控",content="正在获取内存与运行信息…",style=info,script-name=XY_Surge_Monitor,update-interval=1

[Script]
XY_Surge_Monitor = type=generic,engine=webview,timeout=15,script-path=https://raw.githubusercontent.com/xytxg/test/main/Surge/scripts/surge-monitor-pro.js,script-update-interval=60,argument=api_key={{{api_key}}}&api_port={{{api_port}}}&refresh={{{refresh}}}&tap={{{tap}}}&warn_mib={{{warn_mib}}}&restart={{{restart}}}
