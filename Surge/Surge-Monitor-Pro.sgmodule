#!name=Surge Monitor Pro｜状态监控
#!desc=一张面板同时显示 Surge 内存、趋势、运行时长、活动连接、DNS 缓存与配置重载记录。
#!category=Panels
#!arguments=api_key,api_port:6171,refresh:60,tap:reload,warn_mib:45,restart:0
#!arguments-desc=api_key：本机 HTTP API 密钥（内置读取失败时必填）；api_port：HTTP API 端口，默认6171；refresh：页面刷新检查间隔秒，默认60；tap：点击刷新时的操作，reload重载配置/refresh只刷新/restart二次确认停止引擎；warn_mib：超过该MiB值图标变橙；restart：旧版兼容参数，1强制开启二次确认停止功能，不建议开启。

[Panel]
XY_Surge_Monitor = title="Surge 状态监控",content="正在获取内存与运行信息…",style=info,script-name=XY_Surge_Monitor,update-interval={{{refresh}}}

[Script]
XY_Surge_Monitor = type=generic,engine=webview,timeout=15,script-path=https://raw.githubusercontent.com/xytxg/test/main/Surge/scripts/surge-monitor-pro.js,script-update-interval=60,argument=api_key={{{api_key}}}&api_port={{{api_port}}}&refresh={{{refresh}}}&tap={{{tap}}}&warn_mib={{{warn_mib}}}&restart={{{restart}}}
