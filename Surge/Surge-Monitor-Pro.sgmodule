#!name=Surge Monitor Pro｜自动内存监控
#!version=3.1.0
#!desc=定时后台采样引擎内存、峰值、1h均值、30分钟增长预警、DNS趋势和重载前后变化；只读面板，无自动重启和外部遥测。
#!category=Panels
#!arguments=api_key,api_port:6171,wake:true,tap:refresh,warn_mib:45,growth_mib:10
#!arguments-desc=api_key：本机 Surge HTTP API 密钥（读取纯文本指标推荐填写）；api_port：本机 API 端口，默认6171；wake：是否允许 iOS 以静默通知尝试唤醒定时采样（默认true，可能增加耗电）；tap：右上角默认refresh只读，reload才重载配置；warn_mib：内存橙色提示阈值MiB，默认45；growth_mib：连续约30分钟上升预警阈值MiB，默认10（只在面板提示）。

[Panel]
XY_Surge_Monitor = title="Surge 状态监控",content="等待自动采样…",style=info,script-name=XY_Surge_Monitor,update-interval=1

[Script]
# Panel: read-only. Never modifies sampling history.
XY_Surge_Monitor = type=generic,engine=webview,timeout=12,script-path=https://raw.githubusercontent.com/xytxg/test/main/Surge/scripts/surge-monitor-pro-v3.1.0.js,script-update-interval=600,argument=mode=panel&tap={{{tap}}}&warn_mib={{{warn_mib}}}&growth_mib={{{growth_mib}}}
# Cron: 6-minute schedule, 10 executions/hour (Surge warns when >10/hour).
XY_Surge_Sampler = type=cron,cronexp="*/6 * * * *",wake-system={{{wake}}},engine=webview,timeout=15,script-path=https://raw.githubusercontent.com/xytxg/test/main/Surge/scripts/surge-monitor-pro-v3.1.0.js,script-update-interval=600,argument=mode=sample&api_key={{{api_key}}}&api_port={{{api_port}}}&warn_mib={{{warn_mib}}}
# Record an initial point at engine startup.
XY_Surge_OnStart = type=event,event-name=engine-started,engine=webview,timeout=15,script-path=https://raw.githubusercontent.com/xytxg/test/main/Surge/scripts/surge-monitor-pro-v3.1.0.js,script-update-interval=600,argument=mode=start&api_key={{{api_key}}}&api_port={{{api_port}}}
# Listen for actual Surge profile reload events, not just panel button clicks.
XY_Surge_OnReload = type=event,event-name=profile-reloaded,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/xytxg/test/main/Surge/scripts/surge-monitor-pro-v3.1.0.js,script-update-interval=600,argument=mode=reloaded
